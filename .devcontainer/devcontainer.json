{
  "name": "MediLink",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "MediLink web app",
      "onAutoForward": "openBrowser"
    },
    "4000": {
      "label": "MediLink API (no page; use port 3000)",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "Database",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "docker compose -f infra/docker-compose.yml up -d postgres",
  "postAttachCommand": {
    "app": "pnpm start"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
