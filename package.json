{
  "name": "medilink",
  "private": true,
  "description": "MediLink — B2B pharma & FMCG ordering for shops, distributors and sales reps (web, Android, iOS).",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup": "pnpm install && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "dev": "pnpm --filter @medilink/core build && turbo run dev --parallel --filter=@medilink/api --filter=@medilink/web",
    "start": "node tools/start-fast.mjs",
    "dev:mobile": "pnpm --filter @medilink/mobile start",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:migrate": "pnpm --filter @medilink/api prisma:migrate",
    "db:seed": "pnpm --filter @medilink/api prisma:seed",
    "format": "prettier --write .",
    "postinstall": "pnpm --filter @medilink/core build"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.2"
    }
  }
}
