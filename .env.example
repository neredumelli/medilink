# ---------- Database ----------
DATABASE_URL=postgresql://medilink:medilink@localhost:5432/medilink?schema=public
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=4000
# Generate with: openssl rand -hex 32  (never commit real values)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# OTP: "console" logs codes to the API terminal for local dev; "msg91" sends real SMS
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------- Web ----------
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://localhost:4000

# ---------- Mobile (Expo) ----------
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# ---------- Payments / notifications (Phase 4) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_PROVIDER_TOKEN=
FCM_SERVER_KEY=
NEXT_PUBLIC_SUPPORT_PHONE=
